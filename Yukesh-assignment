Assignment 2 — Script to output top 8 IP addresses
#!/usr/bin/bash
# Save this as 'count'.

#Make executable: chmod +x count

# It looks for common log filenames in the current directory.
LOGFILES=("access.log" "logfile" "log" "access_log" "combined.log" "access.log.1" "nginx-access.log")
FOUND=""
for f in "${LOGFILES[@]}"; do
  if [ -f "$f" ]; then
    FOUND="$f"
    break
  fi
done

# Also check in /var/log if nothing found locally
if [ -z "$FOUND" ]; then
  for f in "/var/log/nginx/access.log" "/var/log/httpd/access_log" "/var/log/apache2/access.log"; do
    if [ -f "$f" ]; then
      FOUND="$f"
      break
    fi
  done
fi

if [ -z "$FOUND" ]; then
  echo "No log file found. Place a log file named access.log or logfile in current dir, or update the script."
  exit 1
fi

# Extract first field (IP), count, sort numeric desc, print top 8
awk '{print $1}' "$FOUND" | \
  grep -Eo '([0-9]{1,3}\.){3}[0-9]{1,3}' | \
  sort | uniq -c | sort -nr | head -n 8 | awk '{print $2" "$1}'
